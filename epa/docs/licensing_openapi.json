  "components": {
    "schemas": {
      "Application": {
        "properties": {
          "applicant": {
            "type": "string",
            "maxLength": 150,
            "minLength": 2,
            "title": "Applicant"
          },
          "premises": {
            "type": "string",
            "maxLength": 300,
            "minLength": 3,
            "title": "Premises"
          },
          "activity": {
            "type": "string",
            "maxLength": 500,
            "minLength": 3,
            "title": "Activity"
          },
          "consent_reference": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Consent Reference"
          },
          "fee_reference": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Fee Reference"
          },
          "documents": {
            "items": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 20,
            "title": "Documents"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "applicant",
          "premises",
          "activity"
        ],
        "title": "Application"
      },
      "Command": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "values": {
            "additionalProperties": true,
            "type": "object",
            "title": "Values"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "action"
        ],
        "title": "Command"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Variation": {
        "properties": {
          "licence_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Licence Id"
          },
          "proposed_conditions": {
            "items": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Proposed Conditions"
          },
          "rationale": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Rationale"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "licence_id",
          "proposed_conditions",
          "rationale"
        ],
        "title": "Variation"
      }
    }
  }
