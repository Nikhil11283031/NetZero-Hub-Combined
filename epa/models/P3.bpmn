        <dc:Bounds x="1300" y="230" width="190" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P3_I7_di" bpmnElement="P3_I7">
        <dc:Bounds x="1300" y="530" width="190" height="100" />
      </bpmndi:BPMNShape>
