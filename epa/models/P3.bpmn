        <dc:Bounds x="925" y="230" width="190" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P3_split_di" bpmnElement="P3_split">
        <dc:Bounds x="1180" y="256" width="48" height="48" />
      </bpmndi:BPMNShape>
