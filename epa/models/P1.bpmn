        <dc:Bounds x="440" y="500" width="190" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_A4_di" bpmnElement="P1_A4">
        <dc:Bounds x="180" y="500" width="190" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_timer_di" bpmnElement="P1_timer">
        <dc:Bounds x="315" y="580" width="42" height="42" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_A5_di" bpmnElement="P1_A5">
        <dc:Bounds x="180" y="860" width="190" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_split_di" bpmnElement="P1_split">
        <dc:Bounds x="825" y="256" width="48" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_A6_di" bpmnElement="P1_A6">
        <dc:Bounds x="940" y="230" width="190" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_A7_di" bpmnElement="P1_A7">
        <dc:Bounds x="940" y="510" width="190" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_join_di" bpmnElement="P1_join">
        <dc:Bounds x="1195" y="256" width="48" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_A8_di" bpmnElement="P1_A8">
        <dc:Bounds x="1310" y="230" width="190" height="100" />
      </bpmndi:BPMNShape>
