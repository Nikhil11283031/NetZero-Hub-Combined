        <dc:Bounds x="1730" y="860" width="190" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_A10_di" bpmnElement="P1_A10">
        <dc:Bounds x="1730" y="510" width="190" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_merge_di" bpmnElement="P1_merge">
        <dc:Bounds x="1995" y="886" width="48" height="48" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_A11_di" bpmnElement="P1_A11">
        <dc:Bounds x="2130" y="860" width="190" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_end_di" bpmnElement="P1_end">
        <dc:Bounds x="2400" y="889" width="42" height="42" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P1_flow_0_di" bpmnElement="P1_flow_0">
        <di:waypoint x="142" y="279.0" />
        <di:waypoint x="180" y="280.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_flow_1_di" bpmnElement="P1_flow_1">
        <di:waypoint x="370" y="280.0" />
        <di:waypoint x="440" y="280.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_flow_2_di" bpmnElement="P1_flow_2">
        <di:waypoint x="630" y="280.0" />
        <di:waypoint x="720" y="280.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_flow_3_di" bpmnElement="P1_flow_3">
        <di:waypoint x="744.0" y="304" />
        <di:waypoint x="744.0" y="550.0" />
        <di:waypoint x="630" y="550.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_flow_4_di" bpmnElement="P1_flow_4">
        <di:waypoint x="440" y="550.0" />
        <di:waypoint x="370" y="550.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_flow_5_di" bpmnElement="P1_flow_5">
