<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="P2_definitions" targetNamespace="https://netzero.example/epa" exporter="NetZero coursework model generator" exporterVersion="1.0">
  <bpmn:message id="P2_startMessage" name="startMessage" />
  <bpmn:message id="P2_dataMessage" name="dataMessage" />
  <bpmn:collaboration id="P2_collaboration">
    <bpmn:participant id="P2_consumer" name="Applicant or reporter through NetZero Hub" />
    <bpmn:participant id="P2_epa" name="NSW EPA reference workflow" processRef="P2" />
    <bpmn:messageFlow id="P2_message_0" sourceRef="P2_consumer" targetRef="P2_s" name="request or outcome" />
    <bpmn:messageFlow id="P2_message_1" sourceRef="P2_V8" targetRef="P2_consumer" name="request or outcome" />
  </bpmn:collaboration>
  <bpmn:process id="P2" name="Licence variation" isExecutable="false">
    <bpmn:documentation>Reference-based business model. API implementation covers the selected core. Timeouts and digital integration are project assumptions.</bpmn:documentation>
    <bpmn:laneSet id="P2_lanes">
      <bpmn:lane id="P2_intake" name="Intake and assessment">
        <bpmn:flowNodeRef>P2_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_V1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_V2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_gEligible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_V3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_V4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_V5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_gDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_V7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_registry" name="Registry and outcome">
        <bpmn:flowNodeRef>P2_V6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_V8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P2_s" name="">
      <bpmn:outgoing>P2_flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P2_start_definition" messageRef="P2_startMessage" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="P2_V1" name="V1 Receive variation request">
      <bpmn:incoming>P2_flow_0</bpmn:incoming>
      <bpmn:outgoing>P2_flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P2_V2" name="V2 Verify licence eligibility">
      <bpmn:incoming>P2_flow_1</bpmn:incoming>
      <bpmn:outgoing>P2_flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P2_gEligible" name="Eligible?">
      <bpmn:incoming>P2_flow_2</bpmn:incoming>
      <bpmn:outgoing>P2_flow_3</bpmn:outgoing>
      <bpmn:outgoing>P2_flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P2_V3" name="V3 Record invalid variation">
      <bpmn:incoming>P2_flow_3</bpmn:incoming>
      <bpmn:outgoing>P2_flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P2_V4" name="V4 Assess proposed change">
      <bpmn:incoming>P2_flow_4</bpmn:incoming>
      <bpmn:outgoing>P2_flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P2_V5" name="V5 Decide variation">
      <bpmn:incoming>P2_flow_5</bpmn:incoming>
      <bpmn:outgoing>P2_flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P2_gDecision" name="Approved?">
      <bpmn:incoming>P2_flow_6</bpmn:incoming>
      <bpmn:outgoing>P2_flow_7</bpmn:outgoing>
      <bpmn:outgoing>P2_flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P2_V6" name="V6 Update licence conditions">
      <bpmn:incoming>P2_flow_7</bpmn:incoming>
      <bpmn:outgoing>P2_flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P2_V7" name="V7 Record variation refusal">
      <bpmn:incoming>P2_flow_8</bpmn:incoming>
      <bpmn:outgoing>P2_flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P2_merge" name="">
      <bpmn:incoming>P2_flow_9</bpmn:incoming>
      <bpmn:incoming>P2_flow_10</bpmn:incoming>
      <bpmn:outgoing>P2_flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P2_V8" name="V8 Publish variation outcome">
      <bpmn:incoming>P2_flow_11</bpmn:incoming>
      <bpmn:incoming>P2_flow_12</bpmn:incoming>
      <bpmn:outgoing>P2_flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P2_end" name="">
      <bpmn:incoming>P2_flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P2_flow_0" sourceRef="P2_s" targetRef="P2_V1" name="" />
    <bpmn:sequenceFlow id="P2_flow_1" sourceRef="P2_V1" targetRef="P2_V2" name="" />
    <bpmn:sequenceFlow id="P2_flow_2" sourceRef="P2_V2" targetRef="P2_gEligible" name="" />
    <bpmn:sequenceFlow id="P2_flow_3" sourceRef="P2_gEligible" targetRef="P2_V3" name="no">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">no</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P2_flow_4" sourceRef="P2_gEligible" targetRef="P2_V4" name="yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P2_flow_5" sourceRef="P2_V4" targetRef="P2_V5" name="" />
    <bpmn:sequenceFlow id="P2_flow_6" sourceRef="P2_V5" targetRef="P2_gDecision" name="" />
    <bpmn:sequenceFlow id="P2_flow_7" sourceRef="P2_gDecision" targetRef="P2_V6" name="yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">yes</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P2_flow_8" sourceRef="P2_gDecision" targetRef="P2_V7" name="no">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">no</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P2_flow_9" sourceRef="P2_V6" targetRef="P2_merge" name="" />
    <bpmn:sequenceFlow id="P2_flow_10" sourceRef="P2_V7" targetRef="P2_merge" name="" />
    <bpmn:sequenceFlow id="P2_flow_11" sourceRef="P2_V3" targetRef="P2_V8" name="invalid" />
    <bpmn:sequenceFlow id="P2_flow_12" sourceRef="P2_merge" targetRef="P2_V8" name="" />
    <bpmn:sequenceFlow id="P2_flow_13" sourceRef="P2_V8" targetRef="P2_end" name="" />
    <bpmn:dataObject id="P2_data" />
    <bpmn:dataObjectReference id="P2_data_ref" dataObjectRef="P2_data" name="Case documents" />
    <bpmn:textAnnotation id="P2_effect_V1">
      <bpmn:text>V1 immediate
A variation request referencing an existing licence is recorded.
received(v) ∧ refersTo(v,l)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="P2_effect_V1_assoc" sourceRef="P2_V1" targetRef="P2_effect_V1" />
    <bpmn:textAnnotation id="P2_effect_V2">
      <bpmn:text>V2 immediate
Eligibility and licence version are checked; q is the result.
eligibilityChecked(v) ∧ eligibleResult(v,q)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="P2_effect_V2_assoc" sourceRef="P2_V2" targetRef="P2_effect_V2" />
    <bpmn:textAnnotation id="P2_effect_V3">
      <bpmn:text>V3 immediate
The request is marked invalid; licence conditions stay unchanged.
state(v,invalid) ∧ unchanged(l,v)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="P2_effect_V3_assoc" sourceRef="P2_V3" targetRef="P2_effect_V3" />
    <bpmn:textAnnotation id="P2_effect_V4">
      <bpmn:text>V4 immediate
The proposed change is assessed with result e.
changeAssessed(v) ∧ changeResult(v,e)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="P2_effect_V4_assoc" sourceRef="P2_V4" targetRef="P2_effect_V4" />
    <bpmn:textAnnotation id="P2_effect_V5">
      <bpmn:text>V5 immediate
An authorised officer records a reasoned variation decision d.
decided(v,d) ∧ reasonRecorded(v)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="P2_effect_V5_assoc" sourceRef="P2_V5" targetRef="P2_effect_V5" />
    <bpmn:textAnnotation id="P2_effect_V6">
      <bpmn:text>V6 immediate
The approved conditions replace the previous version.
state(v,approved) ∧ varied(l,v) ∧ version(l,k+1)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="P2_effect_V6_assoc" sourceRef="P2_V6" targetRef="P2_effect_V6" />
    <bpmn:textAnnotation id="P2_effect_V7">
      <bpmn:text>V7 immediate
The variation is refused and the licence is unchanged.
state(v,refused) ∧ unchanged(l,v)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="P2_effect_V7_assoc" sourceRef="P2_V7" targetRef="P2_effect_V7" />
    <bpmn:textAnnotation id="P2_effect_V8">
      <bpmn:text>V8 immediate
The variation outcome is available to its owner.
outcomeAvailable(v)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="P2_effect_V8_assoc" sourceRef="P2_V8" targetRef="P2_effect_V8" />
    <bpmn:textAnnotation id="P2_cum_0">
      <bpmn:text>C4 Change assessed
BaseV(v,l) ∧ changeAssessed(v) ∧ changeResult(v,e)
L = U
X = {V1 · V2[false]}</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="P2_cum_0_assoc" sourceRef="P2_V4" targetRef="P2_cum_0" />
    <bpmn:textAnnotation id="P2_cum_1">
      <bpmn:text>C5 New licence version recorded
C4(v,l) ∧ decided(v,approve) ∧ reasonRecorded(v) ∧ state(v,approved) ∧ varied(l,v) ∧ version(l,k+1)
L = U · V5[approve] · V6
X = {V1 · V2[false], U · V5[refuse]}</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="P2_cum_1_assoc" sourceRef="P2_V6" targetRef="P2_cum_1" />
    <bpmn:textAnnotation id="P2_cum_2">
      <bpmn:text>C6 Refusal preserves the licence
C4(v,l) ∧ decided(v,refuse) ∧ reasonRecorded(v) ∧ state(v,refused) ∧ unchanged(l,v)
L = U · V5[refuse] · V7
X = {V1 · V2[false], U · V5[approve]}</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="P2_cum_2_assoc" sourceRef="P2_V7" targetRef="P2_cum_2" />
    <bpmn:association id="P2_data_assoc" sourceRef="P2_data_ref" targetRef="P2_V2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P2_diagram">
    <bpmndi:BPMNPlane id="P2_plane" bpmnElement="P2_collaboration">
      <bpmndi:BPMNShape id="P2_consumer_di" bpmnElement="P2_consumer" isHorizontal="true">
